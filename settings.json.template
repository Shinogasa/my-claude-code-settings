{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js"
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(~/.claude.json)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.development)",
      "Read(//**/.envrc)",
      "Read(//**/*.tfstate)",
      "Read(//**/*.tfstate.backup)"
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "asana@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_PROFILE": "default"
  },
  "theme": "dark-daltonized",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-dangerous-bash.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/rtk-rewrite.py ]; then python3 ~/.claude/hooks/rtk-rewrite.py; else echo '{\"systemMessage\":\"フック（~/.claude/hooks/rtk-rewrite.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/warn-branch-behind-main.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/jp-doc-review.py ]; then python3 ~/.claude/hooks/jp-doc-review.py pre-tool-use-bash; else echo '{\"systemMessage\":\"フック（~/.claude/hooks/jp-doc-review.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/block-commit-on-merged-pr.py ]; then python3 ~/.claude/hooks/block-commit-on-merged-pr.py; else echo '{\"systemMessage\":\"フック（~/.claude/hooks/block-commit-on-merged-pr.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/require-full-tests-before-pr.py ]; then python3 ~/.claude/hooks/require-full-tests-before-pr.py; else echo '{\"systemMessage\":\"フック（~/.claude/hooks/require-full-tests-before-pr.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/principle-review.py ]; then python3 ~/.claude/hooks/principle-review.py; else echo '{\"systemMessage\":\"原則レビューのフック（~/.claude/hooks/principle-review.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/jp-doc-review.py ]; then python3 ~/.claude/hooks/jp-doc-review.py pre-tool-use-agent; else echo '{\"systemMessage\":\"フック（~/.claude/hooks/jp-doc-review.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create|update)Confluence(Page|FooterComment|InlineComment)",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/jp-doc-review.py ]; then python3 ~/.claude/hooks/jp-doc-review.py pre-tool-use-confluence; else echo '{\"systemMessage\":\"フック（~/.claude/hooks/jp-doc-review.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(create|update)Confluence(Page|FooterComment|InlineComment)",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/jp-doc-review.py ]; then python3 ~/.claude/hooks/jp-doc-review.py post-tool-use-confluence; else echo '{\"systemMessage\":\"フック（~/.claude/hooks/jp-doc-review.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/skill-read-check.py ]; then python3 ~/.claude/hooks/skill-read-check.py stop; else echo '{\"systemMessage\":\"フック（~/.claude/hooks/skill-read-check.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/skill-read-check.py ]; then python3 ~/.claude/hooks/skill-read-check.py subagent-stop; else echo '{\"systemMessage\":\"フック（~/.claude/hooks/skill-read-check.py）が見つからないので検査しなかった。設定リポジトリのブランチを切り替えたなら bash setup.sh --claude を実行する\"}'; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/detect-parallel-sessions.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
