#!/bin/bash
# Bash から `claude -p` を起動するときに使う。親のセッションと同じプロファイルで子を動かす。
#
# bin/ccp で起動したセッションの中から素の `claude -p` を起動すると、子は ~/.claude/settings.json を
# 読み直し、会社の LiteLLM の接続情報で動いてしまう。親の --settings はコマンドライン引数なので子に届かない。
# 一方、設定ファイルの env に書いた値は Bash を通して子まで届き、settings.json に無い変数は上書きされない
# （2026-10-02に確認）。そこで settings.personal.json の env に目印 CLAUDE_PROFILE=personal を、
# settings.json の env に CLAUDE_PROFILE=default を置き、それを見て --settings を付け分ける。
# 既定のプロファイルにも目印を置くのは、次の2つを防ぐため。
#   - 会社のセッションに personal が紛れ込んでも、settings.json の env が default で上書きする
#   - env -i などで目印が消えたときに、個人のつもりで会社の接続へ黙って落ちず、止まる

set -euo pipefail

PERSONAL_SETTINGS="$HOME/.claude/settings.personal.json"

case "${CLAUDE_PROFILE:-}" in
  personal)
    # 個人のつもりで会社の接続情報に繋がる無言の事故を避けるため、設定が無ければ落とす
    if [ ! -f "$PERSONAL_SETTINGS" ]; then
      echo "エラー: $PERSONAL_SETTINGS が見つかりません。bash setup.sh を実行してください。" >&2
      exit 1
    fi
    exec claude --settings "$PERSONAL_SETTINGS" "$@"
    ;;
  default)
    exec claude "$@"
    ;;
  "")
    echo "エラー: CLAUDE_PROFILE が未設定です。どのプロファイルで起動するか決められません。" >&2
    echo "       bash setup.sh を実行したか、環境変数を消す経路（env -i など）を通っていないか確かめてください。" >&2
    exit 1
    ;;
  *)
    echo "エラー: CLAUDE_PROFILE=${CLAUDE_PROFILE} は未知のプロファイルです（personal か default のみ）。" >&2
    exit 1
    ;;
esac
