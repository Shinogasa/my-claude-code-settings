#!/bin/bash
# 同一リポジトリ・同一作業ディレクトリで動いている他の Claude セッションを検出する。
#
# 出力: JSON 配列。検出ゼロなら []
#   [{"pid":1234,"cwd":"/path/to/repo"}]
#
# 終了コード:
#   0 = 検出した（[] なら「いない」）
#   2 = 検出できなかった。標準出力は空で、理由を標準エラーに出す
#
# 判定:
#   git の common-dir が一致し、かつ作業ディレクトリも一致するものだけを衝突とみなす。
#   common-dir が一致して作業ディレクトリが違う場合は worktree で分離済みなので出さない。
#   common-dir は worktree から呼んでも本体と同じ値を返すため、同一リポジトリの
#   判定キーとして使える。
#
#   出力を同一リポジトリのセッションに絞るのは、無関係な他プロジェクトの絶対パスを
#   コンテキストへ漏らさないため。lsof は全セッションの作業ディレクトリを取れてしまう。
#
# 検出できなかったとき:
#   pgrep / lsof / git / jq のいずれかが使えない、または作業ディレクトリの
#   common-dir が取れない場合は、終了コード2で終わる。[] を返すと「いない」と
#   区別できず、本体でブランチを切る前の確認（ADR 0031）が誤って通る。
#   原因ごとに終了コードを分けないのは、どの呼び出し元も原因で行動を変えないため。
#
#   失敗をどう扱うかは呼び出し元が決める。SessionStart フックは、セッション開始を
#   妨げないよう 0 以外で黙って抜ける（fail-open）。手で確認する手順では、
#   「いるかもしれない」として扱う（rules/parallel-worktree.md）。
#
#   --path-format=absolute は git 2.31 以降が必要。これより古いと rev-parse が
#   失敗し、検出できなかったとして終わる。
#
#   列挙の途中で個々のプロセスの cwd が取れないもの（権限など）は飛ばす。
#   これは区別していない。

set -uo pipefail

self_pid=""
while [ $# -gt 0 ]; do
  case "$1" in
    # shift 2 は残り引数が1つのとき失敗し、同じ分岐に入り続けて無限ループになる。
    # 1つずつ落とすことで、値の無い --self-pid でも必ず抜ける。
    --self-pid) shift; self_pid="${1:-}"; [ $# -gt 0 ] && shift ;;
    *)          shift ;;
  esac
done

undetectable() {
  printf '検出できなかった: %s\n' "$1" >&2
  exit 2
}

for tool in git jq; do
  command -v "$tool" >/dev/null 2>&1 || undetectable "$tool が見つからない"
done
# 列挙はプロセス置換の中で動き、失敗が外へ伝わらない。使う道具は先に確かめる
if [ -z "${DETECT_PARALLEL_SESSIONS_FIXTURE:-}" ]; then
  for tool in pgrep lsof; do
    command -v "$tool" >/dev/null 2>&1 || undetectable "$tool が見つからない"
  done
fi

my_common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
  || undetectable "作業ディレクトリの git common-dir を取れない（git 管理外か、git 2.31 未満）"
[ -n "$my_common" ] || undetectable "作業ディレクトリの git common-dir が空"
my_cwd=$(pwd -P)

# セッションの列挙。テストから差し替えられるようファイル経由の差し込み口を持つ。
# eval を使わないのは、環境変数の中身をコマンドとして実行しないため。
enumerate() {
  if [ -n "${DETECT_PARALLEL_SESSIONS_FIXTURE:-}" ]; then
    cat "$DETECT_PARALLEL_SESSIONS_FIXTURE" 2>/dev/null
    return
  fi
  local p c
  for p in $(pgrep -x claude 2>/dev/null); do
    c=$(lsof -a -p "$p" -d cwd -Fn 2>/dev/null | grep '^n' | cut -c2-)
    [ -n "$c" ] && printf '%s\t%s\n' "$p" "$c"
  done
}

# 自分自身と祖先の pid 集合を作る。
# 直接親は sandbox で ps が拒否されても取れる PPID を使い、ps はそれより上を補完する。
# comm 名の一致に依存しないため claude が node 等で動いていても効き、
# pgrep が祖先を返すかどうかにも依存しない。
ancestors=" $$ $PPID "
p=$PPID
while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
  p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  [ -n "$p" ] && ancestors="${ancestors}${p} "
done

first=1
printf '['
while IFS=$'\t' read -r pid cwd; do
  [ -n "${pid:-}" ] && [ -n "${cwd:-}" ] || continue
  [ "$pid" = "$self_pid" ] && continue
  case "$ancestors" in *" $pid "*) continue ;; esac
  [ -d "$cwd" ] || continue

  common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
  [ "$common" = "$my_common" ] || continue

  real=$(cd "$cwd" 2>/dev/null && pwd -P) || continue
  [ "$real" = "$my_cwd" ] || continue

  [ $first -eq 1 ] || printf ','
  first=0
  printf '{"pid":%s,"cwd":%s}' "$pid" "$(printf '%s' "$real" | jq -R .)"
done < <(enumerate)
printf ']\n'
