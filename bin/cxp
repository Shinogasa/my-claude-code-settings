#!/bin/bash
# 個人の ChatGPT アカウントで Codex CLI を起動する。
# 個人用の設定と認証情報は ~/.codex-personal にだけ置き、CODEX_HOME を切り替えて起動する（ADR 0026）。
# 会社用の ~/.codex に個人の auth.json を置かないので、会社用の model_provider が消えても
# 個人アカウントで黙って動くことはない（401 で止まる）。
#
# 素の `codex` は会社設定のままにしてある。逆向き(会社側をラッパー必須)にすると、
# シェル統合が読み込まれなかったときに `codex` が黙って個人アカウントで動いてしまう。
# この向きなら `cxp: command not found` で即座に気づける。

set -euo pipefail

PERSONAL_HOME="$HOME/.codex-personal"

if [ ! -d "$PERSONAL_HOME" ]; then
  echo "エラー: 個人用の $PERSONAL_HOME がありません。作成して個人アカウントでログインしてください。" >&2
  echo "  mkdir -m 700 $PERSONAL_HOME && CODEX_HOME=$PERSONAL_HOME codex login" >&2
  exit 1
fi

# 環境に会社用の CODEX_HOME が残っていても、必ず個人用で起動する
export CODEX_HOME="$PERSONAL_HOME"
exec codex "$@"
