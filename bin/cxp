#!/bin/bash
# 個人の ChatGPT アカウント(OAuth)で Codex CLI を起動する。
# 会社PCでは ~/.codex/config.toml に LLM gateway の provider と認証ヘッダが直書きされて
# いるため、その上へ個人用プロファイルを重ねて provider を切り替える。
#
# 素の `codex` は会社設定のままにしてある。逆向き(会社側をラッパー必須)にすると、
# シェル統合が読み込まれなかったときに `codex` が黙って個人アカウントで動いてしまう。
# この向きなら `cxp: command not found` で即座に気づける。

set -euo pipefail

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
PROFILE_NAME="personal"
PROFILE_FILE="$CODEX_HOME/$PROFILE_NAME.config.toml"
BASE_CONFIG="$CODEX_HOME/config.toml"

# codex は `-p` に存在しないプロファイル名を渡してもエラーにせず、base 設定のまま起動する
# (実測: exit 0 / provider は会社のまま)。個人アカウントのつもりで会社の gateway へ
# 繋がる無言の事故になるため、こちらで明示的に落とす。
if [ ! -f "$PROFILE_FILE" ]; then
  echo "エラー: $PROFILE_FILE が見つかりません。bash setup.sh を実行してください。" >&2
  exit 1
fi

# プロファイルは base に merge される(実測: プロファイル未記載の MCP サーバが起動した)。
# profile 単体の設定検証を通すため transport も転記するので、サーバの追加・削除だけでなく
# url / command の変更も検査し、setup.sh を再実行するまで止める。
python3 - "$BASE_CONFIG" "$PROFILE_FILE" <<'PY'
import pathlib
import sys
import tomllib


def stop(message: str) -> None:
    print(f"エラー: {message}", file=sys.stderr)
    print(
        "       bash setup.sh を実行して personal.config.toml を再生成してください。",
        file=sys.stderr,
    )
    raise SystemExit(1)


def mcp_servers(path: pathlib.Path) -> dict:
    if not path.exists():
        return {}
    with path.open("rb") as f:
        servers = tomllib.load(f).get("mcp_servers", {})
    if not isinstance(servers, dict):
        stop(f"{path} の mcp_servers がテーブルではありません")
    return servers


def transport(name: str, definition, source: pathlib.Path) -> tuple[str, str]:
    if not isinstance(definition, dict):
        stop(f"{source} の MCP サーバ {name} がテーブルではありません")

    keys = [key for key in ("command", "url") if key in definition]
    if len(keys) != 1:
        stop(
            f"{source} の MCP サーバ {name} に有効な transport "
            "(command または url) がありません"
        )

    key = keys[0]
    value = definition[key]
    if not isinstance(value, str) or not value:
        stop(f"{source} の MCP サーバ {name} の {key} が不正です")
    return key, value


base_config, profile = (pathlib.Path(p) for p in sys.argv[1:3])
base_servers = mcp_servers(base_config)
profile_servers = mcp_servers(profile)

missing = sorted(base_servers.keys() - profile_servers.keys())
if missing:
    stop(
        "個人プロファイルが未反映の MCP サーバがあります: "
        + ", ".join(missing)
    )

stale = sorted(profile_servers.keys() - base_servers.keys())
if stale:
    stop(
        "個人プロファイルに削除済みの MCP サーバが残っています: "
        + ", ".join(stale)
    )

mismatched = []
for name in sorted(base_servers):
    profile_definition = profile_servers[name]
    if not isinstance(profile_definition, dict):
        stop(f"個人プロファイルの MCP サーバ {name} がテーブルではありません")
    if not isinstance(profile_definition.get("enabled"), bool):
        stop(f"個人プロファイルの MCP サーバ {name} に boolean の enabled がありません")

    if transport(name, base_servers[name], base_config) != transport(
        name, profile_definition, profile
    ):
        mismatched.append(name)

if mismatched:
    stop(
        "個人プロファイルの transport が古い MCP サーバがあります: "
        + ", ".join(mismatched)
    )
PY

exec codex -p "$PROFILE_NAME" "$@"
