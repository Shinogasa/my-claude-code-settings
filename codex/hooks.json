{
  "description": "Codex CLI 向けのフック配線。Claude Code の settings.json と同じスクリプトを共有する。rtk は出力形式が Codex と非互換のため含めない。",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/guard-dangerous-bash.sh\"",
            "timeout": 30,
            "statusMessage": "危険なコマンドを検査中"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/warn-branch-behind-main.sh\"",
            "timeout": 10,
            "statusMessage": "ブランチの遅れを確認中"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/detect-parallel-sessions.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
