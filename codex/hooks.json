{
  "description": "Codex CLI 向けのフック配線。既存guardはClaude Codeと共有し、親工程切替はCodex専用hookで制御する。RTKはAGENTS.mdとRTK.mdで配布する。",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/codex-model-switch-hook.py\"",
            "timeout": 30,
            "statusMessage": "モデル切替状態を確認中"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/guard-dangerous-bash.sh\"",
            "timeout": 30,
            "statusMessage": "危険なコマンドを検査中"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/warn-branch-behind-main.sh\"",
            "timeout": 10,
            "statusMessage": "ブランチの遅れを確認中"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/detect-parallel-sessions.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/inject-superpowers.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/codex-model-switch-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/codex-model-switch-hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
