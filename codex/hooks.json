{
  "description": "Codex CLI 向けのガードフック。Claude Code の settings.json と同じスクリプトを共有する。",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/guard-dangerous-bash.sh\"",
            "timeout": 30,
            "statusMessage": "危険なコマンドを検査中"
          }
        ]
      }
    ]
  }
}
